{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "CustomResourceDefinition (apiextensions.k8s.io/v1)",
  "type": "object",
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "apiextensions.k8s.io/v1"
    },
    "kind": {
      "const": "CustomResourceDefinition"
    },
    "metadata": {
      "type": "object"
    },
    "spec": {
      "type": "object",
      "required": [
        "group",
        "names",
        "scope",
        "versions"
      ],
      "properties": {
        "group": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "enum": [
            "Cluster",
            "Namespaced"
          ]
        },
        "names": {
          "type": "object",
          "required": [
            "kind",
            "plural"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1
            },
            "plural": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": true
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "served",
              "storage"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "served": {
                "type": "boolean"
              },
              "storage": {
                "type": "boolean"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "status": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
